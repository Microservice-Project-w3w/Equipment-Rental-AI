APP_NAME=Equipment Rental AI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8090
CORS_ORIGINS=http://localhost:5173

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=viet-tutor-frog
OLLAMA_TIMEOUT_SECONDS=120

API_GATEWAY_BASE_URL=http://localhost:8080
API_GATEWAY_TIMEOUT_SECONDS=30

CHAT_HISTORY_LIMIT=20
CHAT_MODE=natural
CHAT_ENABLED_SERVICES=inventory,rental,organization-customer
CHAT_MAX_CONVERSATIONS=200
CHAT_HISTORY_TTL_SECONDS=3600
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_MAX_CONCURRENT_REQUESTS=1
MAX_TOOL_RESULT_CHARS=12000
LOG_LEVEL=INFO

# Optional API-unavailable fallback. Only enable after creating read-only views/account.
AI_DB_FALLBACK_ENABLED=false
AI_DB_HOST=127.0.0.1
AI_DB_PORT=3307
AI_DB_USER=equipment_ai_reader
AI_DB_PASSWORD=
AI_DB_TIMEOUT_SECONDS=5
AI_DB_API_TIMEOUT_SECONDS=3
AI_DB_MAX_ROWS=2000
